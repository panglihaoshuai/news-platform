# Supabase Configuration
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MapLibre / Tile Provider Configuration
# Option 1: Maptiler (Free tier available)
# https://cloud.maptiler.com/
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# RSS Fetcher Configuration
RSSHUB_BASE_URL=https://your-rss-hub-url.com

# App Configuration
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# DeepSeek LLM Configuration (for Smart Classification)
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Alpha Vantage Market Data API
# Get your free API key from: https://www.alphavantage.co/support#api-key
# Free tier: 500 requests/day, 15-20min delayed quotes
NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
